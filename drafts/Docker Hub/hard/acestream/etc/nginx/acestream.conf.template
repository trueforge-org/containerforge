# UNVERIFIED: adapted from the upstream default.conf, which was not fetched.
# Tokens __PORT__, __SCHEME__ and __ENTRY__ are replaced by start.sh.
server {
    listen __PORT__;
    server_name _;

    # Search service (gunicorn on localhost:3031)
    location = /search.m3u {
        proxy_pass http://127.0.0.1:3031;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3031;
        proxy_set_header Host $host;
    }

    # Engine HTTP API (localhost:6878). Rewrites the engine stream port 6868 to the client-facing ENTRY port.
    location /ace/ {
        proxy_pass http://127.0.0.1:6878;
        proxy_set_header Host $host;
        sub_filter_types *;
        sub_filter_once off;
        sub_filter 'http://127.0.0.1:6868' '__SCHEME__://$host__ENTRY__';
    }
}
